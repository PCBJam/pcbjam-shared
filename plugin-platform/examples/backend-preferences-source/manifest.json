{
  "apiVersion": 1,
  "id": "backend-preferences",
  "name": "Backend Preferences",
  "version": "0.1.1",
  "description": "Save a preference to your own backend with verified PCBJam identity.",
  "main": "main.js",
  "ui": "ui.html",
  "surfaces": [
    "editor:eeschema",
    "editor:pcbnew"
  ],
  "permissions": [
    "ui:custom",
    "ui:project-data",
    "network:backend",
    "backend:identity:backend"
  ],
  "endpoints": {
    "backend": {
      "origin": "https://api.your-domain.example",
      "paths": [
        "/v1/preferences"
      ],
      "methods": [
        "GET",
        "POST"
      ],
      "auth": "pcbjam-user"
    }
  }
}
